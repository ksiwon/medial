# Dially — 환경변수 (git-ignored: server/.env 로 복사해 쓴다)
#
# 서버(server/sim_main.py)는 이 파일을 읽지 않는다. 서버는 모델을 부르지 않고 키도 읽지 않는다.
# 이 파일을 읽는 것은 대화록 · 평가를 쓰는 오프라인 도구뿐이다(scripts/gen_week_dialogue.py ·
# scripts/gen_week_evaluations.py, scripts/model.py). 이미 환경에 있는 값이 우선한다.
# 공급자는 OpenAI 하나다.

OPENAI_API_KEY=

# 대화록 · 평가를 쓰는 모델. 판단이 결과인 자리라 높은 층(gpt-6.1-sol)을 쓴다 — 전시의 말은 전부 이 모델이 쓴다.
# MEDIAL_LLM_HEAD_MODEL=gpt-6.1-sol
# MEDIAL_LLM_BASE_URL=https://api.openai.com/v1
