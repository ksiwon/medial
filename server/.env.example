# MEDial 연구 시뮬레이터 — 서버 환경변수 (git-ignored)
#
# real 버전(run-real)만 쓴다. real 서버가 뜰 때 스스로 이 파일을 읽는다(이미 환경에 있는
# 값이 우선). sim 버전(run-sim)은 이 파일을 읽지 않고 모델을 부르지 않는다.
# 공급자는 OpenAI 하나다. 전시 데모(exhibition/)도 같은 키를 읽는다.

OPENAI_API_KEY=

# 모델은 두 층이다. 판단 자체가 결과인 자리는 높은 층(gpt-6-sol),
# 가벼운 모델로 충분한 자리는 낮은 층(gpt-6-luna).
#
# 리뷰·개선(반복 루프) — 주민 평가가 연구가 읽는 결과이므로 높은 층.
MEDIAL_LLM_MODEL=gpt-6-sol

# 마을을 모델로 돌릴 때(실험 준비 → 마을의 행동: LLM) 두 층이 쓰는 모델.
# MEDial 머리는 상황 전체를 읽고 후보를 고르므로 높은 층, 주민은 한 사람의
# 한 답이므로 낮은 층. 둘 다 attempt 입력 해시에 들어간다.
MEDIAL_LLM_HEAD_MODEL=gpt-6-sol
MEDIAL_LLM_RESIDENT_MODEL=gpt-6-luna
# MEDIAL_LLM_TEMPERATURE=0.2   MEDIAL_LLM_MAX_RETRIES=6
