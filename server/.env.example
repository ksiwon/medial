# ═══════════════════════════════════════════════════════════════
# MEDial Live Demo Server — Environment Variables
# Copy to `.env` and fill in your credentials.
# ═══════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=info
# Allowed CORS origins (comma-separated). For dev: include Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ─── Gemini (Primary LLM) ──────────────────────────────────────
# Get key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Primary model. The 기획서 specifies gemini-3.5-flash; fall back to
# gemini-2.5-flash (currently GA) if your project doesn't yet have
# access to 3.5 (release: 2026.05).
LLM_PRIMARY_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
# gemini-3.5-flash는 thinking 모델 — 서버가 thinking_budget=0으로 끔(지연·토큰 잠식 방지).
# 6s: 변동 여유 포함(thinking off 시 ~1.5s). 1024: 리포트 JSON 트렁케이션 방지.
LLM_TIMEOUT_SECONDS=6.0
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.6

# ─── STT (Whisper) ─────────────────────────────────────────────
# Recommended for Korean accuracy:
#   - openai/whisper-large-v3-turbo            (default, multilingual)
#   - ghost613/whisper-large-v3-turbo-korean   (Korean-finetuned)
STT_MODEL_ID=openai/whisper-large-v3-turbo
STT_DEVICE=cuda            # cuda | cpu | mps
STT_DTYPE=float16          # float16 | float32 | bfloat16
STT_LANGUAGE=ko
STT_INITIAL_PROMPT=의료 증상 상담. 두통, 가슴 통증, 어지러움 등.
STT_VAD_ENABLED=true       # use Silero VAD pre-filtering

# ─── TTS (OpenAI) ──────────────────────────────────────────────
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model:
#   gpt-4o-mini-tts  (recommended, steerable via `instructions`)
#   tts-1            (fastest, lower quality, no `instructions`)
#   tts-1-hd         (best quality, no `instructions`)
TTS_MODEL=gpt-4o-mini-tts
# Voice (gpt-4o-mini-tts supports all of these):
#   alloy ash ballad cedar coral echo fable marin nova onyx sage shimmer verse
# `coral` is warm and friendly — recommended for MEDI's elderly-care persona.
TTS_VOICE=coral
# Speech speed: 0.25 to 4.0 (1.0 = normal). 0.9 = elderly-friendly pace.
TTS_SPEED=0.9
# Audio container the server returns to the frontend.
#   wav  — recommended (frontend plays via Blob(audio/wav))
#   mp3 | opus | aac | flac | pcm
TTS_RESPONSE_FORMAT=wav
# `instructions` only applies to gpt-4o-mini-tts. Steers tone/pace/accent.
TTS_INSTRUCTIONS=You are MEDI, a warm Korean female doctor speaking gently to elderly villagers in Korean. Speak slowly and clearly with a caring, empathetic tone. Pronounce Korean naturally; avoid stiff or robotic delivery.

# ─── RAG: PubMed ───────────────────────────────────────────────
# Both files are produced by `scripts/build_pubmed_index.py`.
PUBMED_INDEX_PATH=./data_cache/pubmed_ivfpq.faiss
PUBMED_METADATA_PATH=./data_cache/pubmed_metadata.parquet
PUBMED_ENCODER_MODEL=ncbi/MedCPT-Article-Encoder
PUBMED_QUERY_ENCODER_MODEL=ncbi/MedCPT-Query-Encoder
PUBMED_TOP_K=3
# FAISS IndexIVFPQ params (set during build_pubmed_index.py)
PUBMED_IVFPQ_NLIST=4096
PUBMED_IVFPQ_M=64
PUBMED_IVFPQ_BITS=8
PUBMED_IVFPQ_NPROBE=16
# If you don't have the full PubMed embeddings, restrict to first N snippets
# (set to 0 = use all 23.9M)
PUBMED_BUILD_LIMIT=0

# ─── RAG: DDXPlus ──────────────────────────────────────────────
DDXPLUS_TREE_PATH=./app/data/ddxplus_tree.json
DDXPLUS_KR_PATH=./app/data/ddxplus_kr.json
DDXPLUS_TOP_K=3

# ─── Avatar (Wav2Lip) ──────────────────────────────────────────
# Set to `css` to disable Wav2Lip on the server (frontend falls back
# to its CSS avatar). Set to `wav2lip` to enable real lip-sync inference.
AVATAR_MODE=css
WAV2LIP_CHECKPOINT_PATH=./data_cache/wav2lip_gan.pth
WAV2LIP_FACE_IMAGE_PATH=./data_cache/medi_face.jpg
WAV2LIP_FPS=25
WAV2LIP_RESOLUTION=512

# ─── Session ───────────────────────────────────────────────────
MAX_TURNS=5
SESSION_TIMEOUT_SECONDS=600
EMERGENCY_KEYWORDS=흉통,가슴통증,왼팔,왼쪽팔,턱통증,호흡곤란,의식없,쓰러,안보여,말이 안나와,반신불수

# ─── External tools ────────────────────────────────────────────
# FFmpeg is required to decode webm/opus audio chunks from MediaRecorder.
# `imageio-ffmpeg` ships a bundled binary; set this to override.
FFMPEG_BINARY=
