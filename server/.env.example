# MEDial 연구 시뮬레이터 — 서버 환경변수
#
# 이 파일은 git-ignored 이고, 여기 있는 값은 **서버 프로세스**만 읽습니다.
# 응답·로그·문서·health 어디에도 키가 들어가지 않습니다.
#
# 기본 실행에는 아무것도 필요 없습니다. 규칙 어댑터는 모델을 부르지 않습니다.
# 아래 키는 반복 루프의 리뷰·개선을 **실제 LLM으로 돌릴 때만** 쓰입니다.
#
# run.sh 가 이 파일을 읽어 서버 환경에 넣습니다. 직접 띄울 때는:
#   set -a; . server/.env; set +a; python server/sim_main.py

# ─── 모델 키 ──────────────────────────────────────────────────────
# OPENAI_API_KEY 는 온라인 어댑터가 바로 씁니다 (OpenAI 호환 chat completions).
# ANTHROPIC_API_KEY 가 있으면 그쪽을 먼저 씁니다 (Anthropic Messages).
#
# GOOGLE_API_KEY(Gemini)는 **지금 어댑터가 지원하지 않습니다.** 예전 데모에서
# 쓰던 키이고, 나중에 provider를 늘릴 때를 위해 보관만 합니다.

GOOGLE_API_KEY=
OPENAI_API_KEY=

# ─── 온라인 어댑터 설정 (선택) ────────────────────────────────────
# 키가 없으면 온라인 어댑터를 고를 수 없습니다 (session 생성이 400).
# 키가 있어도 rule 어댑터를 고르면 모델을 한 번도 부르지 않습니다.
#
# MEDIAL_LLM_PROVIDER=anthropic | openai      # 비우면 있는 키로 정합니다
# MEDIAL_LLM_MODEL=claude-opus-5
# MEDIAL_LLM_BASE_URL=                        # OpenAI 호환 게이트웨이를 쓸 때만
# MEDIAL_LLM_TIMEOUT_S=60

# ─── 서버 (선택) ─────────────────────────────────────────────────
# MEDIAL_SIM_PORT=8010                        # run.sh 도 이 값을 씁니다
# MEDIAL_SIM_DB=                              # 비우면 기본 경로의 sqlite
# MEDIAL_VILLAGE_PATH=                        # 비우면 local-data → 없으면 합성
# MEDIAL_PERSONA_PATH=
