# MEDial 연구 시뮬레이터 — 서버 환경변수 (git-ignored)
#
# 기본 실행에는 아무것도 필요 없다. 규칙 어댑터는 모델을 부르지 않는다.
# 아래는 리뷰·개선을 실제 모델로 돌릴 때만 쓰인다.
# run.sh 가 이 파일을 읽어 서버 환경에 넣는다.

GOOGLE_API_KEY=
OPENAI_API_KEY=

# provider 를 비우면 키가 있는 쪽으로 정한다 (anthropic → openai → google).
# 키가 둘 다 있으므로 어느 쪽을 쓸지는 여기서 고른다.
MEDIAL_LLM_PROVIDER=google
MEDIAL_LLM_MODEL=gemini-3.8-flash

# openai 로 바꿀 때: MEDIAL_LLM_PROVIDER=openai · MEDIAL_LLM_MODEL=gpt-5.6-terra
# 더 어려운 판단이 필요하면 gpt-6-astra / claude-opus-5.
