# MEDial 연구 시뮬레이터 — 서버 환경변수 (git-ignored)
#
# 기본 실행에는 아무것도 필요 없다. 규칙 어댑터는 모델을 부르지 않는다.
# 아래는 리뷰·개선·마을을 실제 모델로 돌릴 때만 쓰인다. 공급자는 Gemini 하나다.
# run.sh 가 이 파일을 읽어 서버 환경에 넣는다.

GOOGLE_API_KEY=

# 리뷰·개선(반복 루프)이 쓰는 모델.
MEDIAL_LLM_MODEL=gemini-3.8-flash

# 마을을 모델로 돌릴 때(실험 준비 → 마을의 행동: LLM) 두 층이 쓰는 모델.
# MEDial 머리는 상황 전체를 읽고 후보를 고르므로 큰 모델, 주민은 한 사람의
# 한 답이므로 가벼운 모델. 둘 다 attempt 입력 해시에 들어간다.
MEDIAL_LLM_HEAD_MODEL=gemini-3.8-flash
MEDIAL_LLM_RESIDENT_MODEL=gemini-3.1-flash-lite
# MEDIAL_LLM_TEMPERATURE=0.2   MEDIAL_LLM_MAX_RETRIES=6
