# ═══════════════════════════════════════════════════════════════
# MEDial Live Demo Server — Environment Variables
# cp .env.example .env  후 아래 두 키만 채우면 노트북에서 바로 실행됩니다.
# ═══════════════════════════════════════════════════════════════

# ─── API 키 (필수) ──────────────────────────────────────────────
# Gemini: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI (TTS + notebook STT): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── 실행 환경 ─────────────────────────────────────────────────
# "notebook"  : 로컬 CPU 노트북 — STT를 OpenAI API로, PubMed 인코더 스킵.
#               시작 ~2 s, GPU·로컬 모델 불필요. 데모·개발 기본값.
# "gpu_server": GPU 서버 — 로컬 Whisper + MedCPT 인코더 풀 로드. 발표용.
RUN_MODE=notebook

# ─── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ─── LLM (Gemini) ──────────────────────────────────────────────
# gemini-3.5-flash는 thinking 모델 — thinking_budget=0으로 끔(지연 방지).
LLM_PRIMARY_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=6.0
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.6

# ─── STT ───────────────────────────────────────────────────────
# [notebook]   OpenAI Whisper API — 모델 다운로드 없음, ffmpeg 불필요
STT_OPENAI_MODEL=whisper-1

# [gpu_server] 로컬 HuggingFace Whisper (RUN_MODE=gpu_server 일 때만 사용)
#   openai/whisper-large-v3-turbo            기본, 다국어
#   ghost613/whisper-large-v3-turbo-korean   한국어 파인튠
STT_MODEL_ID=openai/whisper-large-v3-turbo
STT_DEVICE=cuda            # cuda | cpu | mps
STT_DTYPE=float16          # float16 | float32 | bfloat16
STT_VAD_ENABLED=true

# 공통
STT_LANGUAGE=ko
STT_INITIAL_PROMPT=의료 증상 상담. 두통, 가슴 통증, 어지러움 등.

# ─── TTS (OpenAI) ──────────────────────────────────────────────
# gpt-4o-mini-tts: instructions 파라미터로 어조·속도 조절 가능 (권장)
# tts-1          : 빠르지만 instructions 미지원
TTS_MODEL=gpt-4o-mini-tts
# coral: 따뜻하고 친근한 여성 목소리 — 메디 페르소나 기본값
TTS_VOICE=coral
TTS_SPEED=1.05
TTS_RESPONSE_FORMAT=wav
TTS_INSTRUCTIONS=You are MEDI, a warm Korean female doctor speaking gently to elderly villagers in Korean. Speak slowly and clearly with a caring, empathetic tone. Pronounce Korean naturally; avoid stiff or robotic delivery.

# ─── RAG: PubMed ───────────────────────────────────────────────
# notebook 모드에서는 인코더 로딩을 스킵하므로 인덱스 파일이 없어도 됩니다.
# gpu_server 모드에서 빌드: python scripts/build_pubmed_index.py
PUBMED_INDEX_PATH=./data_cache/pubmed_ivfpq.faiss
PUBMED_METADATA_PATH=./data_cache/pubmed_metadata.parquet
PUBMED_ENCODER_MODEL=ncbi/MedCPT-Article-Encoder
PUBMED_QUERY_ENCODER_MODEL=ncbi/MedCPT-Query-Encoder
PUBMED_TOP_K=3
PUBMED_IVFPQ_NLIST=4096
PUBMED_IVFPQ_M=64
PUBMED_IVFPQ_BITS=8
PUBMED_IVFPQ_NPROBE=16
PUBMED_BUILD_LIMIT=0

# ─── RAG: DDXPlus ──────────────────────────────────────────────
DDXPLUS_TREE_PATH=./app/data/ddxplus_tree.json
DDXPLUS_KR_PATH=./app/data/ddxplus_kr.json
DDXPLUS_TOP_K=3

# ─── Avatar ────────────────────────────────────────────────────
# css    : CSS 애니메이션 아바타 (기본, GPU 불필요)
# wav2lip: 실제 립싱크 추론 (GPU + 체크포인트 필요)
AVATAR_MODE=css
WAV2LIP_CHECKPOINT_PATH=./data_cache/wav2lip_gan.pth
WAV2LIP_FACE_IMAGE_PATH=./data_cache/medi_face.jpg
WAV2LIP_FPS=25
WAV2LIP_RESOLUTION=512

# ─── Session ───────────────────────────────────────────────────
MAX_TURNS=5
SESSION_TIMEOUT_SECONDS=600
EMERGENCY_KEYWORDS=흉통,가슴통증,왼팔,왼쪽팔,턱통증,호흡곤란,의식없,쓰러,안보여,말이 안나와,반신불수

# ─── External tools ────────────────────────────────────────────
# notebook 모드 STT는 API를 사용하므로 ffmpeg 불필요.
# gpu_server 모드에서 webm 디코딩에 필요. imageio-ffmpeg로 자동 설치됨.
FFMPEG_BINARY=
